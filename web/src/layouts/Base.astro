---
import "../styles/globals.css";

/**
 * The one layout. Identical chrome on every route, homepage included.
 *
 * The theme script is `is:inline` on purpose: Astro would otherwise hoist it
 * into a bundled module with `type="module"`, which defers execution until
 * after the document parses, and any deferral of this particular script is a
 * flash of the wrong theme.
 */
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  /** Only math posts pay for KaTeX's stylesheet. */
  math?: boolean;
  /** A file in public/og/, without the extension. Defaults to the site card. */
  ogImage?: string;
  /** /fun and /interviews stay out of an index. */
  noindex?: boolean;
}

const SITE = "https://samitmohan.in";
const DEFAULT_DESCRIPTION =
  "AI Scientist at Beltech AI in Bangalore. I rebuild ML from scratch and write about it.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonical,
  ogType = "website",
  math = false,
  ogImage = "index",
  noindex = false,
} = Astro.props;

// Next built this from a title template; here it is one expression.
const fullTitle = title ? `${title} - Samit Mohan` : "Samit Mohan";
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, SITE).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Samit Mohan",
  url: SITE,
  image: `${SITE}/photo.jpeg`,
  jobTitle: "AI Scientist",
  worksFor: { "@type": "Organization", name: "Beltech AI", url: "https://beltech.ai" },
  email: "mailto:samitmohan@gmail.com",
  sameAs: ["https://github.com/samitmohan", "https://www.linkedin.com/in/samit-mohan/"],
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "New Horizon College of Engineering, VTU",
  },
  knowsAbout: [
    "Computer Vision",
    "Deep Learning",
    "PyTorch",
    "Machine Learning",
    "LLMs",
    "Inference Optimization",
  ],
};
---

<!doctype html>
<html lang="en" class="h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta name="theme-color" content="#FFFDF8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0D0C09" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href="/icon0.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon1.png" sizes="192x192" type="image/png" />
    <link rel="alternate" type="application/rss+xml" title="Samit Mohan" href="/blog/rss.xml" />

    <meta property="og:site_name" content="Samit Mohan" />
    <meta property="og:title" content={title ?? "Samit Mohan"} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${SITE}/og/${ogImage}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? "Samit Mohan"} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og/${ogImage}.png`} />

    <script is:inline>
      try {
        var t = localStorage.getItem("theme");
        if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>

    {math && <link rel="stylesheet" href="/katex/katex.min.css" />}

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>

  <body class="min-h-full flex flex-col bg-background text-foreground">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[200] focus:px-3 focus:py-1.5 focus:rounded-md focus:bg-primary focus:text-primary-foreground focus:text-small"
      >Skip to content</a
    >
    <slot />
  </body>
</html>
