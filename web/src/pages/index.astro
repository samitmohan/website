---
import Base from "../layouts/Base.astro";
import Figure from "../components/Figure.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

/**
 * One screen, three doors: the name (about) and the two figures (blog,
 * projects), under one line saying what the work is.
 *
 * Nothing here loops. Everything arrives once, on one gesture: the name, the
 * line and the two doors blur in on a stagger and then stop. The name used to
 * write itself instead - see .wordmark-head in globals.css for why it does
 * not any more.
 */
---

<Base canonical="/">
  <div class="home">
    <Nav />

    <main id="main" class="home-stage">
      {/* The drawn name is the heading, so it is inside the h1 rather than
          beside an sr-only copy of it. The svg carries its own title, but a
          heading a screen reader announces as "samit" and a page about Samit
          Mohan are not the same string, so the full name is spelled out. */}
      <h1 class="wordmark-head blur-in" style="--delay: 60ms">
        <a href="/about" class="wordmark" aria-label="About">
          <Figure name="wordmark" class="wordmark-word" />
          {/* The drawing the favicon is cut from, beside the name. It carried
              its own fade so it could land with the pen's ink; the whole
              lockup blurs in together now, so it does not need one. */}
          <span class="wordmark-computer" aria-hidden="true"></span>
          <span class="sr-only">Samit Mohan</span>
        </a>
      </h1>

      {/* The mark is on the claim the page wants you to act on, and it is the
          link to the blog rather than decoration next to one. It does not draw
          itself: a link whose underline is invisible for the first 1.7s is a
          link nobody can see. One gesture on load, not two. */}
      <p class="home-line blur-in" style="--delay: 180ms">
        I rebuild ML from scratch and <a href="/blog" class="mark-under"
          >write about it<svg
            aria-hidden="true"
            viewBox="0 0 200 10"
            preserveAspectRatio="none"
            ><path d="M2 6.2 C 34 2.6, 62 8.4, 96 4.6 S 158 8.2, 198 3.4"></path></svg
          ></a
        >.
      </p>
    </main>

    <div class="home-doors">
      <a href="/blog" class="door door-blog blur-in" style="--delay: 300ms">
        <Figure name="blog-backprop" class="door-figure" />
        <span class="door-label">Blog</span>
      </a>
      <a href="/projects" class="door door-projects blur-in" style="--delay: 400ms">
        <Figure name="agent-loop" class="door-figure" />
        <span class="door-label">Projects</span>
      </a>
    </div>

    <Footer />
  </div>
</Base>
