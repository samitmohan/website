---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PostRuntime from "../../components/PostRuntime.astro";
import FunPost from "../../components/FunPost.astro";
import {
  getPost,
  getAllPosts,
  getHiddenPosts,
  getAllSlugs,
  formatPostDate,
} from "../../lib/blog";
import { markdownToHtml } from "../../lib/markdown";

export function getStaticPaths() {
  return getAllSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const post = getPost(slug!);
if (!post) throw new Error(`no post for slug ${slug}`);

const html = await markdownToHtml(post.content, post.math);

// Neighbours and related stay inside the same visibility set, so hidden posts
// never link out to the public blog and vice versa.
const siblings = post.hidden ? getHiddenPosts() : getAllPosts();
const i = siblings.findIndex((p) => p.slug === slug);
const prevPost = i < siblings.length - 1 ? siblings[i + 1] : null;
const nextPost = i > 0 ? siblings[i - 1] : null;

const related = siblings
  .filter((p) => p.slug !== slug && p.tags.some((t) => post.tags.includes(t)))
  .slice(0, 3);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  description: post.description,
  author: { "@type": "Person", name: "Samit Mohan", url: "https://samitmohan.in" },
  datePublished: post.date,
  dateModified: post.date,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `https://samitmohan.in/blog/${post.slug}`,
  },
  publisher: { "@type": "Person", name: "Samit Mohan" },
};
---

<Base
  title={post.title}
  description={post.description}
  canonical={`/blog/${slug}`}
  ogType="article"
  math={post.math}
  ogImage={post.hidden ? "index" : slug}
  noindex={post.hidden}
>
  {/* Hidden posts get the warm reading layout instead of the blog chrome. */}
  {post.hidden ? (
    <FunPost post={post} html={html} prevPost={prevPost} nextPost={nextPost} />
  ) : (
  <div class="page">
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <PostRuntime />
    <Nav />

    <main id="main" class="mx-auto max-w-[44rem] px-6 py-14 md:py-20">
      <div class="label mb-10 flex items-center gap-2">
        <a href="/blog" class="transition-colors hover:text-brand">Posts</a>
        <span class="text-ink-4">/</span>
        <span class="truncate text-ink-2">{post.title}</span>
      </div>

      <header class="mb-8">
        <h1 class="display text-balance text-title text-ink md:text-head">{post.title}</h1>
        <div class="mt-7 flex items-center gap-3 border-y border-rule py-4">
          <img
            src="/photo.jpeg"
            alt=""
            width="72"
            height="72"
            class="h-9 w-9 rounded-full object-cover"
          />
          <span class="text-small font-medium text-ink">Samit Mohan</span>
          <span class="meta ml-auto flex items-center gap-2">
            <time>{formatPostDate(post.date)}</time>
            <span class="text-ink-4">・</span>
            <span>{post.readingTime} min</span>
          </span>
        </div>
      </header>

      {
        post.thumbnail && (
          <div class="mb-12 overflow-hidden rounded-[var(--radius-card)] border border-rule bg-surface-2">
            <img src={post.thumbnail} alt="" class="aspect-[16/9] w-full object-cover" />
          </div>
        )
      }

      <article class="mt-10">
        <div class="blog-prose" set:html={html} />
      </article>

      {
        related.length > 0 && (
          <section class="mt-16 border-t border-rule pt-10">
            <h2 class="label mb-6">Related posts</h2>
            <div class="rows">
              {related.map((p) => (
                <a href={`/blog/${p.slug}`} class="row">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                    <h3 class="text-body font-medium leading-snug text-ink">{p.title}</h3>
                    <span class="meta shrink-0">
                      {formatPostDate(p.date)} · {p.readingTime} min
                    </span>
                  </div>
                  {p.description && (
                    <p class="mt-1.5 max-w-3xl text-pretty text-small leading-[155%] text-ink-2">
                      {p.description}
                    </p>
                  )}
                </a>
              ))}
            </div>
          </section>
        )
      }

      <div class="mt-16 grid gap-4 border-t border-rule pt-8 sm:grid-cols-2">
        <div>
          {
            prevPost && (
              <a href={`/blog/${prevPost.slug}`} class="group block">
                <p class="label mb-2">← Older</p>
                <p class="text-small leading-snug text-ink-2 transition-colors group-hover:text-brand">
                  {prevPost.title}
                </p>
              </a>
            )
          }
        </div>
        <div class="sm:text-right">
          {
            nextPost && (
              <a href={`/blog/${nextPost.slug}`} class="group block">
                <p class="label mb-2">Newer →</p>
                <p class="text-small leading-snug text-ink-2 transition-colors group-hover:text-brand">
                  {nextPost.title}
                </p>
              </a>
            )
          }
        </div>
      </div>
    </main>

    <Footer />
  </div>
  )}
</Base>
