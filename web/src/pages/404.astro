---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <div class="flex min-h-screen items-center justify-center bg-background px-6 text-foreground">
    <div class="text-center">
      <p class="label mb-4">404</p>
      <h1 class="display text-balance text-title text-ink md:text-head">page not found</h1>
      <p class="mt-4 text-small text-ink-2">the link is wrong or the post moved.</p>
      <div class="mt-7 flex items-center justify-center gap-2">
        <a href="/" class="pill pill-ghost">home</a>
        <a href="/blog" class="pill pill-ghost">posts</a>
      </div>
    </div>
  </div>
</Base>
