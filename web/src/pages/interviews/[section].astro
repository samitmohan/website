---
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import PostRuntime from "../../components/PostRuntime.astro";
import InterviewFilters from "../../components/interviews/InterviewFilters.astro";
import SubBlock from "../../components/interviews/SubBlock.astro";
import QACard from "../../components/interviews/QACard.astro";
import PaperCard from "../../components/interviews/PaperCard.astro";
import { SECTIONS } from "../../lib/interviews-data";
import { facetsFor, isQASection, qaId, sectionHref, stripNum } from "../../lib/interviews";

/**
 * One section, answers included. Open and close is native <details>, so the
 * answer HTML is painted at build time and never passes through any script.
 * The filter bar is scoped to this section's questions.
 */
export function getStaticPaths() {
  return SECTIONS.map((s) => ({ params: { section: s.id } }));
}

const { section: id } = Astro.params;
const section = SECTIONS.find((s) => s.id === id);
if (!section) throw new Error(`no interview section ${id}`);

const title = stripNum(section.title);
const i = SECTIONS.findIndex((s) => s.id === section.id);
const prev = i > 0 ? SECTIONS[i - 1] : null;
const next = i < SECTIONS.length - 1 ? SECTIONS[i + 1] : null;
const facets = facetsFor([section]);
---

<Base title={`${title} - Interviews`} canonical={`/interviews/${id}`} noindex>
  <div class="page">
    <Nav />
    {/* The copy buttons on the code cards use the delegated listener here. */}
    <PostRuntime />

    <main id="main" class="flex-1 w-full max-w-2xl mx-auto px-6 py-12 md:py-16">
      <div
        class="mb-8 flex items-center gap-2 font-mono text-micro uppercase tracking-[0.08em] text-muted-foreground/70"
      >
        <a href="/interviews" class="hover:text-primary">Interviews</a>
        <span class="text-muted-foreground/40">/</span>
        <span class="truncate">{title}</span>
      </div>

      <header class="mb-8 pb-6 border-b border-border">
        <h1
          class="text-2xl md:text-3xl font-semibold tracking-tight text-foreground leading-[1.15]"
        >
          {title}
        </h1>
        {
          facets.total > 0 && (
            <p class="text-small font-mono text-muted-foreground/60 mt-2">
              {facets.total} questions
            </p>
          )
        }
      </header>

      {facets.total > 0 && <InterviewFilters facets={facets} />}

      <div id="interviews-body">
        {section.type === "info" && <div class="interviews-prose" set:html={section.html} />}

        {section.type === "papers" && section.papers.map((p) => <PaperCard paper={p} />)}

        {
          isQASection(section) &&
            section.subs.map((sub, subIdx) => (
              <SubBlock title={sub.title}>
                {sub.qs.map((qa, qIdx) => (
                  <QACard
                    id={qaId(section.id, subIdx, qIdx)}
                    q={qa.q}
                    difficulty={qa.difficulty}
                    tags={qa.tags}
                    code={qa.code}
                  >
                    <div set:html={qa.a} />
                  </QACard>
                ))}
              </SubBlock>
            ))
        }
      </div>

      <div class="mt-16 grid gap-4 border-t border-border pt-8 sm:grid-cols-2">
        <div>
          {
            prev && (
              <a href={sectionHref(prev.id)} class="group block">
                <p class="mb-1 font-mono text-micro uppercase tracking-[0.08em] text-muted-foreground/60">
                  ← Previous
                </p>
                <p class="text-small leading-snug text-muted-foreground group-hover:text-primary">
                  {stripNum(prev.title)}
                </p>
              </a>
            )
          }
        </div>
        <div class="sm:text-right">
          {
            next && (
              <a href={sectionHref(next.id)} class="group block">
                <p class="mb-1 font-mono text-micro uppercase tracking-[0.08em] text-muted-foreground/60">
                  Next →
                </p>
                <p class="text-small leading-snug text-muted-foreground group-hover:text-primary">
                  {stripNum(next.title)}
                </p>
              </a>
            )
          }
        </div>
      </div>
    </main>

    <Footer />
  </div>
</Base>
