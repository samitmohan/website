---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SectionRail from "../components/interviews/SectionRail.astro";
import InterviewFilters from "../components/interviews/InterviewFilters.astro";
import SubBlock from "../components/interviews/SubBlock.astro";
import QALink from "../components/interviews/QALink.astro";
import { SECTIONS } from "../lib/interviews-data";
import {
  facetsFor,
  isQASection,
  qaId,
  questionCount,
  sectionHref,
  sectionNav,
  stripNum,
} from "../lib/interviews";

/**
 * Every question, no answers. The 234 answers are 202 KB of the guide's
 * 300 KB, so they live on the per-section routes and this stays a fast,
 * filterable catalogue. The filter bar still spans the whole corpus because
 * every question is painted here.
 */
const sections = sectionNav();
const facets = facetsFor(SECTIONS);
---

<Base
  title="Interviews"
  canonical="/interviews"
  noindex
  description="ML interview prep for 2026: math, deep learning, LLMs, CV, systems, inference/MLOps, NeetCode 150, and projects to build."
>
  <div class="page">
    {/* Inbound links to the old single-page guide carry a section fragment.
        Forward them to the section's own route so they still land somewhere. */}
    <script is:inline>
      try {
        var h = location.hash.slice(1);
        if (/^s[0-9]+$/.test(h)) location.replace("/interviews/" + h);
      } catch (e) {}
    </script>

    <Nav />
    <SectionRail sections={sections} />

    <main id="main" class="flex-1 w-full max-w-2xl mx-auto px-6 py-12 md:py-16">
      <header class="mb-10 pb-6 border-b border-border">
        <h1
          class="text-3xl md:text-4xl font-semibold tracking-tight text-foreground mb-2 leading-[1.1]"
        >
          Interview Preparation
        </h1>
        <p class="text-small text-muted-foreground leading-relaxed">
          Questions I need to prepare for interviews 2026.
        </p>
        <p class="text-small font-mono text-muted-foreground/60 mt-2">
          {facets.total} questions across {sections.length} sections
        </p>
      </header>

      <InterviewFilters facets={facets} />

      <div id="interviews-body">
        {
          SECTIONS.map((sec) => {
            const title = stripNum(sec.title);
            const href = sectionHref(sec.id);
            return (
              <section
                id={sec.id}
                data-section={isQASection(sec) ? "qa" : "static"}
                class="mb-14 scroll-mt-20"
              >
                <div class="mb-4 flex items-baseline justify-between gap-4 border-b border-border pb-2">
                  <h2 class="text-body font-semibold tracking-tight text-foreground">
                    <a href={href} class="hover:text-primary">
                      {title}
                    </a>
                  </h2>
                  <span class="shrink-0 font-mono text-micro text-muted-foreground/60">
                    {isQASection(sec) ? `${questionCount(sec)} questions` : "read"}
                  </span>
                </div>

                {isQASection(sec) ? (
                  sec.subs.map((sub, subIdx) => (
                    <SubBlock title={sub.title}>
                      {sub.qs.map((qa, qIdx) => (
                        <QALink
                          href={`${href}#${qaId(sec.id, subIdx, qIdx)}`}
                          q={qa.q}
                          difficulty={qa.difficulty}
                          tags={qa.tags}
                        />
                      ))}
                    </SubBlock>
                  ))
                ) : (
                  <a href={href} class="text-small text-muted-foreground hover:text-primary">
                    Open section →
                  </a>
                )}
              </section>
            );
          })
        }
      </div>
    </main>

    <Footer />
  </div>
</Base>
