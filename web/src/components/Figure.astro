---
import { inlineSvg } from "../lib/inline-svg";

/**
 * An SVG from public/, inlined. See lib/inline-svg.ts for why these are not
 * <img>: their ink is currentColor and their palette is driven from
 * globals.css, neither of which reaches a separate document.
 */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<span class={className} set:html={inlineSvg(name)} />
