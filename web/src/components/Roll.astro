---
/**
 * A label whose letters roll over on hover: each one is a two-glyph column
 * clipped to one line, and the column slides up by exactly one line.
 *
 * duforn.com's, where every link in the chrome does it. Theirs is driven from
 * JavaScript, which it does not need to be - the split is the same on every
 * render, so it happens here at build time and the movement is a transition.
 * Nothing ships to the browser.
 *
 * The per-character delay is the whole effect. All at once is a crossfade with
 * extra steps; 16ms apart reads as the word being retyped left to right.
 *
 * Splitting a word into glyphs breaks two things that are not visual, and
 * both are fixed here rather than accepted. A screen reader would announce
 * "b, l, o, g", so every column is aria-hidden and the real string is a text
 * node the reader gets instead. Selecting the row would copy "bblloogg", so
 * the columns are user-select: none and the real string is what the selection
 * picks up. duforn.com fixes the first and not the second.
 */
interface Props {
  text: string;
  class?: string;
}
const { text, class: cls } = Astro.props;
const chars = [...text];
---

<span class:list={["roll", cls]}>
  <span class="roll-real">{text}</span>
  {
    chars.map((c, i) => (
      <span class="roll-c" aria-hidden="true" style={`--i:${i}`}>
        <span class="roll-s">
          <span>{c === " " ? " " : c}</span>
          <span>{c === " " ? " " : c}</span>
        </span>
      </span>
    ))
  }
</span>
