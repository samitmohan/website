---
import Figure from "./Figure.astro";

/**
 * The one interactive thing on the site.
 *
 * Nothing else moves on its own. With the ambient motion gone there is room
 * for exactly one object that answers a click, and this figure is the
 * candidate because it is the only drawing whose subject is a sequence: a
 * forward pass, a loss, and gradients coming back the same way.
 *
 * It lives on /blog rather than on the homepage door. The door is a link, and
 * a button inside a link is invalid markup and unusable with a keyboard.
 *
 * The state is a class list on an ancestor of the inlined svg, so globals.css
 * does the revealing and this is a counter and two arrays. It was 61 lines of
 * React; the React was never holding anything the DOM was not.
 */
const STEPS = [
  ["", "click to step"],
  ["on-f0", "forward · x → h₁"],
  ["on-f0 on-f1", "forward · h₁ → h₂"],
  ["on-f0 on-f1 on-f2", "forward · h₂ → ŷ"],
  ["on-f0 on-f1 on-f2 on-loss", "loss"],
  ["on-f0 on-f1 on-f2 on-loss on-b2", "backward · ∂L/∂h₂"],
  ["on-f0 on-f1 on-f2 on-loss on-b2 on-b1", "backward · ∂L/∂h₁"],
  ["on-f0 on-f1 on-f2 on-loss on-b2 on-b1 on-b0", "backward · ∂L/∂x"],
] as const;
---

<div class="page-figure page-figure-blog bp-stepper">
  <button
    type="button"
    class="bp-stage"
    aria-label="Backpropagation diagram: step through the forward and backward pass"
    data-bp-stage
  >
    <Figure name="blog-backprop" class="bp-art" />
  </button>
  {/* Announced on each step, so the sequence is available without seeing
      which edges lit. */}
  <p class="bp-caption" aria-live="polite" data-bp-caption>{STEPS[0][1]}</p>
</div>

<script define:vars={{ STEPS }}>
  const stage = document.querySelector<HTMLElement>("[data-bp-stage]");
  const caption = document.querySelector<HTMLElement>("[data-bp-caption]");
  let step = 0;
  stage?.addEventListener("click", () => {
    step = (step + 1) % STEPS.length;
    stage.className = `bp-stage ${STEPS[step][0]}`.trim();
    if (caption) caption.textContent = STEPS[step][1];
  });
</script>
