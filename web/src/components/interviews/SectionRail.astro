---
/**
 * Sticky section rail. One absolutely positioned pill slides between entries
 * rather than each row carrying its own background.
 *
 * Only renders from xl up, where the centred column leaves a free gutter; the
 * anchor list at the top of the page is the narrow-screen fallback.
 *
 * The React version held the active id and the hovered id in state and then
 * wrote the pill's geometry straight to the node anyway, with a comment
 * explaining that keeping it in state would re-render the rail on every hover.
 * Both observations were right, which is why there is no state here.
 */
interface Props {
  sections: { id: string; title: string }[];
}
const { sections } = Astro.props;
---

<nav
  aria-label="Sections"
  class="fixed top-28 left-[max(1.5rem,calc(50%-38rem))] z-30 hidden w-52 xl:block"
  data-iv-toc
>
  <div
    class="mb-2 px-2 font-mono text-micro uppercase tracking-[0.08em] text-muted-foreground/60"
  >
    Sections
  </div>
  <div class="relative flex flex-col gap-px" data-rail-list>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 rounded-md bg-muted opacity-0"
      style="transition: top 220ms var(--motion-ease), height 220ms var(--motion-ease), opacity 150ms ease"
      data-rail-box></span>
    {
      sections.map((s, i) => (
        <a
          href={`#${s.id}`}
          data-rail-id={s.id}
          class="relative z-10 flex items-center gap-2 rounded-md px-2 py-1.5 text-small transition-colors duration-150"
        >
          <span class="font-mono text-micro tabular-nums text-muted-foreground/40">
            {String(i + 1).padStart(2, "0")}
          </span>
          <span
            class="min-w-0 flex-1 truncate text-muted-foreground transition-colors duration-150"
            data-rail-label
          >
            {s.title}
          </span>
        </a>
      ))
    }
  </div>
</nav>

<script>
  const list = document.querySelector<HTMLElement>("[data-rail-list]");
  const box = document.querySelector<HTMLElement>("[data-rail-box]");
  if (list && box) {
    const links = Array.from(list.querySelectorAll<HTMLElement>("[data-rail-id]"));
    let activeId: string | null = null;
    let hovered: string | null = null;

    function place() {
      // The `if (list && box)` guard above does not narrow inside a closure.
      if (!list || !box) return;
      const key = hovered ?? activeId;
      const target = key ? list.querySelector<HTMLElement>(`[data-rail-id="${key}"]`) : null;
      if (!target) {
        box.style.opacity = "0";
        return;
      }
      box.style.opacity = "1";
      box.style.top = `${target.offsetTop}px`;
      box.style.height = `${target.offsetHeight}px`;
    }

    function mark() {
      for (const a of links) {
        const on = a.dataset.railId === activeId;
        const label = a.querySelector<HTMLElement>("[data-rail-label]");
        if (on) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
        label?.classList.toggle("font-medium", on);
        label?.classList.toggle("text-foreground", on);
        label?.classList.toggle("text-muted-foreground", !on);
      }
    }

    // Track the topmost section intersecting the upper band of the viewport,
    // so the rail marks what you are reading rather than what scrolled past.
    const targets = links
      .map((a) => document.getElementById(a.dataset.railId ?? ""))
      .filter((el): el is HTMLElement => el !== null);
    if (targets.length && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]) {
            activeId = visible[0].target.id;
            mark();
            place();
          }
        },
        { rootMargin: "-88px 0px -65% 0px", threshold: 0 },
      );
      for (const el of targets) io.observe(el);
    }

    list.addEventListener("mouseleave", () => {
      hovered = null;
      place();
    });
    for (const a of links) {
      a.addEventListener("mouseenter", () => {
        hovered = a.dataset.railId ?? null;
        place();
      });
      a.addEventListener("focus", () => {
        hovered = a.dataset.railId ?? null;
        place();
      });
      a.addEventListener("blur", () => {
        hovered = null;
        place();
      });
    }
  }
</script>
