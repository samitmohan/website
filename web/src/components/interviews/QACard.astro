---
import CodeCard from "../ui/CodeCard.astro";
import type { Difficulty, Tag } from "../../lib/interviews-data";

/**
 * Expandable Q&A with no JavaScript at all - native <details>/<summary> does
 * open and close.
 *
 * The facets live on the node as data-* so the filter bar can hide
 * non-matching questions without any of this content passing through it.
 */
const SPECIAL_TAGS: Partial<Record<Tag, string>> = {
  frontier: "text-purple-600",
  startup: "text-primary",
};
const DIFFICULTY_DOT: Record<Difficulty, string> = {
  easy: "bg-[#16a34a]",
  med: "bg-[#ca8a04]",
  hard: "bg-destructive",
};

interface Props {
  id: string;
  q: string;
  difficulty: Difficulty;
  tags: Tag[];
  code?: string;
}
const { id, q, difficulty, tags, code } = Astro.props;
const isKey = tags.includes("key" as Tag);
const specialTags = tags.filter((t) => t in SPECIAL_TAGS);
---

<details
  id={id}
  data-qa
  data-difficulty={difficulty}
  data-tags={tags.join(" ")}
  data-q={q.toLowerCase()}
  class={`group mb-1 scroll-mt-24 border-l-2 pl-3 ${isKey ? "border-l-[#ca8a04]" : "border-l-transparent"}`}
>
  <summary
    class="flex items-center gap-3 py-1.5 cursor-pointer list-none [&::-webkit-details-marker]:hidden"
  >
    <span
      class={`w-1.5 h-1.5 rounded-full flex-shrink-0 ${DIFFICULTY_DOT[difficulty]}`}
      title={difficulty}
    />
    <span class="flex-1 min-w-0 text-small text-foreground leading-snug">
      {q}
      {
        specialTags.length > 0 && (
          <span class="ml-2">
            {specialTags.map((t) => (
              <span class={`text-micro font-medium mr-1.5 ${SPECIAL_TAGS[t as Tag]}`}>{t}</span>
            ))}
          </span>
        )
      }
    </span>
    <span class="text-muted-foreground/50 text-micro flex-shrink-0 group-open:rotate-90">▶</span>
  </summary>
  <div class="interviews-prose pb-3 pt-1">
    <slot />
    {code && <CodeCard code={code} />}
  </div>
</details>
